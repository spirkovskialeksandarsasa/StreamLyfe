# Client ID of your app from https://developer.spotify.com/dashboard
VITE_REACT_APP_CLIENT_ID=

# Must exactly match a Redirect URI added in the Spotify dashboard.
# Defaults to <current site>/callback, e.g. http://127.0.0.1:5173/callback when running locally.
# VITE_REACT_APP_REDIRECT_URI=https://your-domain.com/callback
